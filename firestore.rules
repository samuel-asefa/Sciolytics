rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // ── Users ────────────────────────────────────────────────────────────────
    // profile is readable by any signed-in user (team rosters, leaderboards)
    match /users/{uid}/profile/data {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
    // everything else under a user (progress, sessions, bookmarks, flashcards,
    // cheatsheets, wikiNotes, notifications) is private to that user
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ── Teams ────────────────────────────────────────────────────────────────
    match /teams/{document=**} {
      allow read, write: if signedIn();
    }

    // ── Custom tests ─────────────────────────────────────────────────────────
    match /customTests/{testId} {
      allow read: if signedIn() && (resource.data.creatorId == request.auth.uid || resource.data.get('isPublic', false) == true);
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.creatorId == request.auth.uid;

      // Community ratings: one doc per rater, 1–5 stars, can't rate your own test
      match /ratings/{raterId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == raterId
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5
          && get(/databases/$(database)/documents/customTests/$(testId)).data.creatorId != request.auth.uid;
        allow delete: if signedIn() && request.auth.uid == raterId;
      }
    }

    // collectionGroup('ratings') queries for the Community page
    match /{path=**}/ratings/{raterId} {
      allow read: if signedIn();
    }

    // ── Partner mode ─────────────────────────────────────────────────────────
    match /partnerSessions/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.questionIds.size() <= 100;
      // participants join themselves and write answers/flags; host can't be changed
      allow update: if signedIn()
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.questionIds == resource.data.questionIds
        && (request.auth.uid in resource.data.participants
            || request.resource.data.participants.diff(resource.data.participants).affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;
    }

    // ── Official bank ────────────────────────────────────────────────────────
    match /officialQuestions/{document=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.token.email == 'samuelasefa20@gmail.com';
    }
  }
}
